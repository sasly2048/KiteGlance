<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Plain net8.0, NOT net8.0-windows: these tests cover pure P&L arithmetic
      and carry no WPF dependency, so they run on the Linux CI runner too.
      The production project multi-targets the Holding type's logic with no
      UI coupling, which is what makes it testable here.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Required for ProtectedData (DPAPI) used in CredentialVault -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      We link the relevant source files rather than referencing the
      WPF project (which targets net8.0-windows and would drag WPF
      onto a plain-net8.0 test assembly). The classes inside these
      files are the unit under test; compiling them here in
      isolation keeps the tests cross-platform.

      Wildcards are used so adding a new pure file under
      `src/KiteGlance/Services/` (e.g. `PortfolioAssembler.cs`) does
      not require editing this project file. The earlier version
      listed files one-by-one, and the audit noted that pattern was
      fragile - a single rename in `src/` would silently break the
      test build. The wildcards below are restricted to the
      `Services/` folder, and `Theme.cs` is excluded because it
      imports `System.Windows` (WPF), which is not available on
      the net8.0 (non-Windows) target.
    -->
    <Compile Include="../../src/KiteGlance/Services/*.cs" Link="Services/%(Filename)%(Extension)" Exclude="../../src/KiteGlance/Services/Theme.cs" />
    <Compile Include="../../src/KiteGlance/State/*.cs" Link="State/%(Filename)%(Extension)" />
    <!--
      DesktopPinLogic is the pure decision-logic half of the
      desktop-pin WndProc hook: it tests whether a given Win32
      message or size would lead to a WS_MINIMIZE state. The rest of
      DesktopPin.cs is WPF and ComCtl32 glue that needs an
      HwndSource; testing it would require a full Windows desktop,
      so we link only the pure part here. Note: a wildcard for
      `Interop/*.cs` would also pull in `DesktopPin.cs` and break
      the Linux build, so the explicit list is intentional.
    -->
    <Compile Include="../../src/KiteGlance/Interop/DesktopPinLogic.cs" Link="Interop/DesktopPinLogic.cs" />
    <!--
      `SpringMath` is the pure-math half of the WPF-coupled
      `SpringEase` class. The latter derives from
      `System.Windows.Media.Animation.EasingFunctionBase` and so
      cannot be linked into the net8.0 (non-Windows) test
      assembly; the math lives in `SpringMath.Ease`, which is
      the only file we link.
    -->
    <Compile Include="../../src/KiteGlance/Motion/SpringMath.cs" Link="Motion/SpringMath.cs" />
  </ItemGroup>

</Project>
