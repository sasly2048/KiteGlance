<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Plain net8.0, NOT net8.0-windows: these tests cover pure P&L arithmetic
      and carry no WPF dependency, so they run on the Linux CI runner too.
      The production project multi-targets the Holding type's logic with no
      UI coupling, which is what makes it testable here.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Required for ProtectedData (DPAPI) used in CredentialVault -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      We link the single source file under test rather than referencing the
      WPF project (which targets net8.0-windows and would drag WPF onto a
      plain-net8.0 test assembly). The Holding class inside KiteService.cs is
      the unit under test; compiling it here in isolation keeps the tests
      cross-platform. If Holding ever moves to its own Models/ file, point
      this Compile Include at that file instead.
    -->
    <Compile Include="../../src/KiteGlance/Services/PnlMath.cs" Link="PnlMath.cs" />
    <Compile Include="../../src/KiteGlance/Services/BackdropService.cs" Link="BackdropService.cs" />
    <Compile Include="../../src/KiteGlance/Services/CredentialVault.cs" Link="CredentialVault.cs" />
    <Compile Include="../../src/KiteGlance/Services/AmfiNavService.cs" Link="AmfiNavService.cs" />
    <Compile Include="../../src/KiteGlance/Services/KiteService.cs" Link="KiteService.cs" />
    <Compile Include="../../src/KiteGlance/State/WidgetState.cs" Link="WidgetState.cs" />
    <Compile Include="../../src/KiteGlance/Services/Log.cs" Link="Log.cs" />
    <Compile Include="../../src/KiteGlance/Services/PriceHistoryService.cs" Link="PriceHistoryService.cs" />
    <!--
      DesktopPinLogic is the pure decision-logic half of the desktop-pin
      WndProc hook: it tests whether a given Win32 message or size would
      lead to a WS_MINIMIZE state. The rest of DesktopPin.cs is WPF and
      ComCtl32 glue that needs an HwndSource; testing it would require a
      full Windows desktop, so we link only the pure part here.
    -->
    <Compile Include="../../src/KiteGlance/Interop/DesktopPinLogic.cs" Link="DesktopPinLogic.cs" />
  </ItemGroup>

</Project>
