<Application x:Class="KiteGlance.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:KiteGlance.Motion"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!--
            PALETTE
            Apple's dark-mode system colors. The four-step label ladder
            (100 / 55 / 30 / 18 percent white) is what gives Apple UI its depth
            without drawing a single line.
        -->
        <SolidColorBrush x:Key="Green" Color="#32D74B" />
        <SolidColorBrush x:Key="Red"   Color="#FF453A" />
        <SolidColorBrush x:Key="Blue"  Color="#0A84FF" />
        <SolidColorBrush x:Key="Amber" Color="#FF9F0A" />

        <SolidColorBrush x:Key="Label"  Color="#FFFFFF" />
        <SolidColorBrush x:Key="Label2" Color="#FFFFFF" Opacity="0.55" />
        <SolidColorBrush x:Key="Label3" Color="#FFFFFF" Opacity="0.30" />
        <SolidColorBrush x:Key="Label4" Color="#FFFFFF" Opacity="0.18" />

        <SolidColorBrush x:Key="Fill"      Color="#FFFFFF" Opacity="0.05" />
        <SolidColorBrush x:Key="Separator" Color="#FFFFFF" Opacity="0.08" />
        <SolidColorBrush x:Key="Track"     Color="#FFFFFF" Opacity="0.07" />

        <!--
            BACKDROP
            Painted from code: MainWindow crossfades between the four
            pre-rendered mesh gradients in Assets/ (dawn, day, dusk, night;
            see BackdropService for the selection rules) or a user-chosen
            image. Only the base Surface colour lives here, as the paint
            under everything and the fallback if an image fails to decode.
        -->
        <SolidColorBrush x:Key="Surface" Color="#FF101318" />

        <LinearGradientBrush x:Key="Scrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0"   Color="#FF14171D" />
            <GradientStop Offset="1"   Color="#FF0C0E12" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopSheen" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0"   Color="#00FFFFFF" />
            <GradientStop Offset="0.5" Color="#26FFFFFF" />
            <GradientStop Offset="1"   Color="#00FFFFFF" />
        </LinearGradientBrush>

        <!--
            GRAIN
            A near-black vertical gradient on an 8-bit display bands: flat
            plateaus of colour with hard steps between them. Tiled monochrome
            noise at 2.5% dithers those plateaus into stochastic pixels, and the
            eye integrates them back into a smooth ramp.

            You have never consciously noticed this on Linear or Arc. That is
            exactly the point. It is felt, not seen.
        -->
        <ImageBrush x:Key="Grain"
                    ImageSource="Assets/grain.png"
                    TileMode="Tile"
                    Viewport="0,0,128,128"
                    ViewportUnits="Absolute"
                    Opacity="0.028"
                    Stretch="None" />


        <!--
            ICONS
            Vector, 16x16 grid, 1.6px stroke, round caps and joins.
            v5 used the text glyph U+22EE for the menu button: it inherits font
            metrics and sits on a baseline rather than an optical centre.
            Nothing in a premium product is a character pretending to be an icon.
        -->
        <GeometryGroup x:Key="IconMore">
            <EllipseGeometry Center="8,3.1"  RadiusX="1.15" RadiusY="1.15" />
            <EllipseGeometry Center="8,8"    RadiusX="1.15" RadiusY="1.15" />
            <EllipseGeometry Center="8,12.9" RadiusX="1.15" RadiusY="1.15" />
        </GeometryGroup>

        <PathGeometry x:Key="IconChevron" Figures="M 3.5,6.25 L 8,10.75 L 12.5,6.25" />
        <PathGeometry x:Key="IconArrow"   Figures="M 3.5,8 L 12.5,8 M 9,4.5 L 12.5,8 L 9,11.5" />
        <PathGeometry x:Key="IconCheck"   Figures="M 3.2,8.4 L 6.4,11.6 L 12.8,4.6" />


        <!--
            FOCUS
            v5 set FocusVisualStyle to null to kill Windows' dotted rectangle.
            That removed the interface for keyboard users — a regression, not a
            fix. A real ring, shown only when focus arrives from the keyboard.
        -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="10" RadiusY="10"
                                   Stroke="{StaticResource Blue}"
                                   StrokeThickness="2" Opacity="0.9"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--
            MOTION
            Two laws, and they differ on purpose.

            Layout SPRINGS. Overshoot reads as weight, as mass arriving.
            Numbers EASE. Overshoot would mean rendering a value you never held
            and then correcting it. Money must never overshoot.
        -->
        <motion:SpringEase x:Key="SpringLayout" Stiffness="170" Damping="20" EasingMode="EaseIn" />
        <motion:SpringEase x:Key="SpringGentle" Stiffness="130" Damping="22" EasingMode="EaseIn" />
        <motion:SpringEase x:Key="SpringSnap"   Stiffness="320" Damping="15" EasingMode="EaseIn" />


        <!-- ICON BUTTON -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{StaticResource Label3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Fill}" />
                                <Setter Property="Foreground" Value="{StaticResource Label}" />
                            </Trigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.9" Duration="0:0:0.07" />
                                        <DoubleAnimation Storyboard.TargetName="sc"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.9" Duration="0:0:0.07" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc"
                                            Storyboard.TargetProperty="ScaleX" To="1"
                                            Duration="0:0:0.42"
                                            EasingFunction="{StaticResource SpringSnap}" />
                                        <DoubleAnimation Storyboard.TargetName="sc"
                                            Storyboard.TargetProperty="ScaleY" To="1"
                                            Duration="0:0:0.42"
                                            EasingFunction="{StaticResource SpringSnap}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- EXPANDER -->
        <Style x:Key="Expander" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{StaticResource Label2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Separator}"
                                BorderThickness="0,1,0,0" Padding="20,13">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Fill}" />
                                <Setter Property="Foreground" Value="{StaticResource Label}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- TAB -->
        <Style x:Key="Tab" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{StaticResource Label3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,0,2,10">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Label2}" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <!--
            HOLDING ROW
            Lifts 2px and its fill fades in on hover, both spring-eased.
            Restraint is the point: a row that leaps at the cursor is a row that
            will annoy you by the thousandth time you see it.
        -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                    To="#12FFFFFF" Duration="0:0:0.18" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                    To="2" Duration="0:0:0.45"
                                    EasingFunction="{StaticResource SpringLayout}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                    To="#00FFFFFF" Duration="0:0:0.26" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                    To="0" Duration="0:0:0.45"
                                    EasingFunction="{StaticResource SpringGentle}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- PRIMARY -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#3395FF" />
                                    <GradientStop Offset="1" Color="#0A84FF" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.97" Duration="0:0:0.07" />
                                        <DoubleAnimation Storyboard.TargetName="sc"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.97" Duration="0:0:0.07" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc"
                                            Storyboard.TargetProperty="ScaleX" To="1"
                                            Duration="0:0:0.45"
                                            EasingFunction="{StaticResource SpringSnap}" />
                                        <DoubleAnimation Storyboard.TargetName="sc"
                                            Storyboard.TargetProperty="ScaleY" To="1"
                                            Duration="0:0:0.45"
                                            EasingFunction="{StaticResource SpringSnap}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--
            SKELETON
            Bars that breathe at the exact shape of the content arriving.
            Not a spinner. A spinner says "something is happening, somewhere".
            A skeleton says "your money will be here, in this shape, shortly".
        -->
        <Style x:Key="Bone" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Opacity" Value="0.06" />
            <Setter Property="CornerRadius" Value="5" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.05" To="0.11" Duration="0:0:1.05">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>


        <!-- INPUTS -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Fill}" />
            <Setter Property="Foreground" Value="{StaticResource Label}" />
            <Setter Property="CaretBrush" Value="{StaticResource Blue}" />
            <Setter Property="BorderBrush" Value="{StaticResource Separator}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource Blue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interval picker in Settings. Matches Input's surface, radius and
             focus behaviour; WPF's stock ComboBox chrome is Aero-era and would
             read as a foreign control in this window. -->
        <Style x:Key="IntervalPicker" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Fill}" />
            <Setter Property="Foreground" Value="{StaticResource Label}" />
            <Setter Property="BorderBrush" Value="{StaticResource Separator}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                              Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{StaticResource Fill}"
                                                BorderBrush="{StaticResource Separator}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <ContentPresenter Margin="11,8"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center" />
                                                <Path HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,11,0"
                                                      Width="9" Height="6"
                                                      Stretch="Uniform"
                                                      Data="M 0,0 L 5,5 L 10,0"
                                                      Stroke="{StaticResource Label3}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush"
                                                        Value="{StaticResource Label4}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="11,8,30,8"
                                              IsHitTestVisible="False"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="#F51A1C20"
                                        BorderBrush="{StaticResource Separator}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Padding="4">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush"
                                        Value="{StaticResource Blue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Label}" />
                        <Setter Property="Padding" Value="9,7" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background"
                                                    Value="#1AFFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background"
                                                    Value="#1AFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secret" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Fill}" />
            <Setter Property="Foreground" Value="{StaticResource Label}" />
            <Setter Property="CaretBrush" Value="{StaticResource Blue}" />
            <Setter Property="BorderBrush" Value="{StaticResource Separator}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource Blue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- SCROLLBAR -->
        <Style x:Key="Hairline" TargetType="ScrollBar">
            <Setter Property="Width" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,4,3,4" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#40FFFFFF" CornerRadius="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FadedList" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0"    Color="#00000000" />
                                    <GradientStop Offset="0.05" Color="#FF000000" />
                                    <GradientStop Offset="0.93" Color="#FF000000" />
                                    <GradientStop Offset="1"    Color="#00000000" />
                                </LinearGradientBrush>
                            </Grid.OpacityMask>

                            <ScrollContentPresenter Margin="{TemplateBinding Padding}" />

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource Hairline}"
                                       HorizontalAlignment="Right"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PART_VerticalScrollBar"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PART_VerticalScrollBar"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.45" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- CONTEXT MENU -->
        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Label}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Margin="5,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Path x:Name="check" Grid.Column="0"
                                      Width="11" Height="11"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Data="{StaticResource IconCheck}"
                                      Stretch="Uniform"
                                      Stroke="{StaticResource Blue}"
                                      StrokeThickness="1.7"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />

                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Label4}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Submenu PARENT items need their own template: MenuItemStyle above
            is click-terminal by design (border, check, header, done), which
            means a nested MenuItem styled with it has no Popup to open its
            children into. Clicking it does nothing, silently. This style is
            that template plus the two missing organs: a chevron so the item
            reads as "contains more", and the PART_Popup the children live in.
        -->
        <Style x:Key="MenuParentStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Label}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="bd" Background="Transparent"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    Margin="5,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      VerticalAlignment="Center" />

                                    <!-- Chevron: this row opens, not acts. -->
                                    <Path Grid.Column="2" Width="5" Height="9"
                                          Margin="10,0,2,0"
                                          VerticalAlignment="Center"
                                          Data="M 0,0 L 4,4.5 L 0,9"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource Label3}"
                                          StrokeThickness="1.5"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="4" VerticalOffset="-6"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <!-- Margin gives the shadow room to breathe;
                                     otherwise the popup clips it flat. -->
                                <Border Background="#F51A1C20"
                                        BorderBrush="{StaticResource Separator}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0,5"
                                        Margin="0,0,10,10"
                                        MinWidth="176">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.5" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Label4}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="12,5" />
            <Setter Property="Background" Value="{StaticResource Separator}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F51A1C20" />
            <Setter Property="BorderBrush" Value="{StaticResource Separator}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                MinWidth="196">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
