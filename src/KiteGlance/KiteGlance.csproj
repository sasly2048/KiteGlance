<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <RootNamespace>KiteGlance</RootNamespace>
    <AssemblyName>KiteGlance</AssemblyName>

    <AssemblyTitle>Kite Glance</AssemblyTitle>
    <Product>Kite Glance</Product>
    <Company>Raghavendra G</Company>
    <Description>A desktop widget for your Zerodha portfolio.</Description>
    <Copyright>Copyright (c) 2026 Raghavendra G</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    Release ships one file, self-contained, no .NET install needed on the
    target machine. This is what makes it a normal Windows app rather than
    a dev artifact.

    Trimming is deliberately OFF: WPF resolves types through XAML reflection,
    so the trimmer strips things it cannot see being used, and you get a
    binary that builds clean then dies at runtime. Not worth the 30MB.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to 8.0.0 to match the test assembly, which uses 8.0.0
      for the same reason. Mismatched versions between the
      production binary and the test assembly were a maintenance
      trap before 1.5.0: the production binary's DPAPI bindings
      disagreed with the test assembly's in subtle ways on Linux
      runners. Bumping either side now bumps the other.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\grain.png" />
    <Resource Include="Assets\backdrop-dawn.png" />
    <Resource Include="Assets\backdrop-sunrise.png" />
    <Resource Include="Assets\backdrop-day.png" />
    <Resource Include="Assets\backdrop-noon.png" />
    <Resource Include="Assets\backdrop-dusk.png" />
    <Resource Include="Assets\backdrop-evening.png" />
    <Resource Include="Assets\backdrop-night.png" />
    <Resource Include="Assets\backdrop-midnight.png" />
  </ItemGroup>

  <!--
    Grant the test assembly visibility of `internal` members, so
    `KiteService.Checksum` and the WPF-coupled `WindowMaterial`
    helpers can be exercised directly. Without this, the test that
    used to exist called `SHA256.HashData` (a copy of the relevant
    one-liner) and missed the real production method.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="KiteGlance.Tests" />
  </ItemGroup>

</Project>
